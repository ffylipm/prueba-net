{
  "ConnectionStrings": {
    "Main": "Data Source=../../data/portal.db"
  },
  "Worker": {
    "PollIntervalSeconds": 5,
    "BatchSize": 10,
    "MaxAttempts": 3,
    "ProcessingTimeoutSeconds": 60
  },
  "Provider": {
    "FailureRate": 0.3,
    "LatencyMs": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
